cmake_minimum_required(VERSION 4.0)
project(SomethingUsingExceptions CXX)

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

include_directories(include)

# Look for custom Find*.cmake files in the project's cmake directory.
list(APPEND CMAKE_MODULE_PATH
    "${CMAKE_CURRENT_SOURCE_DIR}/cmake"
  )

# set(sodium_USE_STATIC_LIBS ON)
# find_package(Sodium REQUIRED)

set(PKG_CONFIG_ARGN "--static")
find_package(PkgConfig REQUIRED)

# STATIC asks pkg-config for the static link flags.
pkg_check_modules(SODIUM REQUIRED IMPORTED_TARGET libsodium)

find_path(SODIUM_INCLUDE_DIR
    NAMES sodium.h
    REQUIRED
)

find_library(SODIUM_STATIC_LIBRARY
    NAMES libsodium.a sodium
    REQUIRED
)

set(SODIUM_SRC
    src/sodium-test.cpp
)

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY
    "${CMAKE_BINARY_DIR}/"
  )

  add_executable(sodium-test ${SODIUM_SRC})

  target_link_libraries(sodium-test "${SODIUM_STATIC_LIBRARY}")

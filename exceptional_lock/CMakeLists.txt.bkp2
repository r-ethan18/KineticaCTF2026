cmake_minimum_required(VERSION 3.22)

project(SomethingUsingExceptions LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(PkgConfig REQUIRED)
pkg_check_modules(SODIUM REQUIRED libsodium)

find_path(SODIUM_INCLUDE_DIR
    NAMES sodium.h
    HINTS ${SODIUM_INCLUDE_DIRS}
    REQUIRED
)

find_file(SODIUM_STATIC_LIBRARY
    NAMES libsodium.a
    HINTS ${SODIUM_LIBRARY_DIRS}
    REQUIRED
)

message(STATUS "libsodium headers: ${SODIUM_INCLUDE_DIR}")
message(STATUS "libsodium static library: ${SODIUM_STATIC_LIBRARY}")

add_executable(sodium-test
    src/sodium-test.cpp
)

target_include_directories(sodium-test
    PRIVATE
        ${SODIUM_INCLUDE_DIR}
)

target_link_options(sodium-test
    PRIVATE
        -Wl,-Bstatic
)

target_link_libraries(sodium-test
    PRIVATE
        ${SODIUM_STATIC_LIBRARY}
)

target_link_options(sodium-test
    PRIVATE
        -Wl,-Bdynamic
)

{
  description = "C/C++ dev env";

  # Reuse your system's cached nixpkgs to avoid a 1 GB download
  inputs.nixpkgs.url = "nixpkgs";

  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
    in {
      devShells.${system}.default = pkgs.mkShell {
        packages = with pkgs; [
          gcc
          clang-tools
          gdb
          cmake
          gnumake
          pkgsStatic.libsodium
          pkg-config
        ];
      };
    };
}
